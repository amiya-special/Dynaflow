# Copy to .env and edit locally. Never commit credentials.
# UTF-8 KEY=value; no shell expansion. Existing environment variables take precedence.

# Main API: OpenAI-compatible Chat Completions. Include /v1 if required by the service.
DYNAFLOW_BASE_URL=http://127.0.0.1:8000/v1
DYNAFLOW_MODEL=your-model-name
# openai or deepseek; use deepseek for its thinking/tool-call protocol.
DYNAFLOW_MODEL_ADAPTER=openai
DYNAFLOW_API_KEY=
DYNAFLOW_CONCURRENCY=1
DYNAFLOW_TRAINING_STAGE=unspecified

# Optional subagent overrides; blank values reuse the main API.
DYNAFLOW_CLOUD_URL=
DYNAFLOW_CLOUD_MODEL=
DYNAFLOW_CLOUD_ADAPTER=
DYNAFLOW_CLOUD_API_KEY=

# Optional page-summary API overrides; blank values reuse the main API.
DYNAFLOW_FETCH_BASE_URL=
DYNAFLOW_FETCH_MODEL=
DYNAFLOW_FETCH_ADAPTER=
DYNAFLOW_FETCH_API_KEY=

# Required for Workflow demos: configure the web service and its credential.
# Model API credentials do not authenticate web search or page extraction.
# Search providers: tavily, exa, deepseek. Page extraction: tavily, deepseek.
DYNAFLOW_SEARCH_PROVIDER=tavily
DYNAFLOW_FETCH_PROVIDER=tavily
TAVILY_ENDPOINT_URL=https://api.tavily.com/search
# Required when using the official endpoint above.
TAVILY_API_KEY=
# TAVILY_ENDPOINT_URL may select a compatible proxy; TAVILY_API_KEY is sent only to api.tavily.com.
# Only needed if selecting the corresponding alternative web provider.
EXA_API_KEY=
DEEPSEEK_API_KEY=
# Web provider failures do not switch providers automatically.

DYNAFLOW_CONTAINER_IMAGE=node:24.14.0-bookworm-slim
DYNAFLOW_TOOLS_IMAGE=dynaflow-tools:py311-v1
# Only for an externally managed tool service.
DYNAFLOW_TOOL_API_KEY=

